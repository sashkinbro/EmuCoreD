*.3ds
*.3dsx
*.cci
*.cxi
*.cia
*.app
*.iso
*.cso
*.chd

# Native build artifacts (generated outside ignored build dirs)
/EmuCoreD-release.apk
CMakeUserPresets.json
compile_commands.json

# Firebase local state and project configuration - never commit
.firebase/
.firebaserc
firebase.json
firestore.rules
firestore.indexes.json
firebase-debug.log
firestore-debug.log
ui-debug.log

# Firebase client configuration for this app (contains project API keys)
/app/google-services.json

# Release signing material
*.jks
*.keystore

