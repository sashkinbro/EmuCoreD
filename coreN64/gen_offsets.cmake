execute_process(COMMAND "${STRINGS}" "${OBJECT}" RESULT_VARIABLE result OUTPUT_VARIABLE data)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not read N64 dynarec ABI offsets")
endif()
string(REGEX MATCHALL "@ASM_DEFINE offsetof_struct_[a-zA-Z_0-9]+ 0x[0-9a-fA-F]+" definitions "${data}")
if(NOT definitions)
    message(FATAL_ERROR "N64 dynarec ABI offsets are missing")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(nasm "")
set(gas "")
foreach(definition IN LISTS definitions)
    string(REGEX REPLACE "@ASM_DEFINE ([^ ]+) (.+)" "%define \\1 (\\2)\n" nasm_line "${definition}")
    string(REGEX REPLACE "@ASM_DEFINE ([^ ]+) (.+)" "#define \\1 (\\2)\n" gas_line "${definition}")
    string(APPEND nasm "${nasm_line}")
    string(APPEND gas "${gas_line}")
endforeach()
file(WRITE "${OUTPUT_DIR}/asm_defines_nasm.h" "${nasm}")
file(WRITE "${OUTPUT_DIR}/asm_defines_gas.h" "${gas}")
