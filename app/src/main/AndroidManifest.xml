<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- WorkManager declares FOREGROUND_SERVICE for its optional foreground workers; this app
         never runs a foreground service, so the permission is stripped from the merged manifest. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Discord Social SDK: permissions added by the SDK AAR are not needed. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <!-- Android 11+ package visibility hides other apps from queryIntentActivities unless the
         queried intents are declared here. Without these entries the TV storage picker cannot
         see an installed file manager (DocumentsUI, AnExplorer, X-plore) and reports that no
         compatible picker exists even when one is installed. The OPEN_DOCUMENT filter must
         mirror the picker filters (OPENABLE + any MIME type) or file managers that omit the
         OPEN_DOCUMENT_TREE filter stay hidden. -->
    <queries>
        <package android:name="dev.dworks.apps.anexplorer" />
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".EmuCoreDApp"
        android:allowBackup="true"
        android:appCategory="game"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmuCoreD"
        tools:ignore="UnusedAttribute">
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:theme="@style/Theme.EmuCoreD.Splash">
            <intent-filter>
                <action android:name="com.sbro.emucored.action.LAUNCH_GAME" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="emucored" android:host="launch" />
            </intent-filter>

            <!-- Launcher frontends (Beacon, Daijisho, DIG, ES-DE, LaunchBox
                 custom emulators, ...) open game images with a plain VIEW
                 intent, by file path or by content URI. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:pathPattern=".*\\.3ds" />
                <data android:scheme="file" android:pathPattern=".*\\.3DS" />
                <data android:scheme="file" android:pathPattern=".*\\.3dsx" />
                <data android:scheme="file" android:pathPattern=".*\\.3DSX" />
                <data android:scheme="file" android:pathPattern=".*\\.cci" />
                <data android:scheme="file" android:pathPattern=".*\\.CCI" />
                <data android:scheme="file" android:pathPattern=".*\\.cxi" />
                <data android:scheme="file" android:pathPattern=".*\\.CXI" />
                <data android:scheme="file" android:pathPattern=".*\\.app" />
                <data android:scheme="file" android:pathPattern=".*\\.APP" />
                <data android:scheme="file" android:pathPattern=".*\\.axf" />
                <data android:scheme="file" android:pathPattern=".*\\.AXF" />
                <data android:scheme="file" android:pathPattern=".*\\.elf" />
                <data android:scheme="file" android:pathPattern=".*\\.ELF" />
                <data android:scheme="file" android:pathPattern=".*\\.zcci" />
                <data android:scheme="file" android:pathPattern=".*\\.ZCCI" />
                <data android:scheme="file" android:pathPattern=".*\\.zcxi" />
                <data android:scheme="file" android:pathPattern=".*\\.ZCXI" />
                <data android:scheme="file" android:pathPattern=".*\\.nds" />
                <data android:scheme="file" android:pathPattern=".*\\.NDS" />
                <data android:scheme="file" android:pathPattern=".*\\.srl" />
                <data android:scheme="file" android:pathPattern=".*\\.SRL" />
                <data android:scheme="file" android:pathPattern=".*\\.dsi" />
                <data android:scheme="file" android:pathPattern=".*\\.DSI" />
                <data android:scheme="file" android:pathPattern=".*\\.gba" />
                <data android:scheme="file" android:pathPattern=".*\\.GBA" />
                <data android:scheme="file" android:pathPattern=".*\\.agb" />
                <data android:scheme="file" android:pathPattern=".*\\.AGB" />
                <data android:scheme="file" android:pathPattern=".*\\.gb" />
                <data android:scheme="file" android:pathPattern=".*\\.GB" />
                <data android:scheme="file" android:pathPattern=".*\\.sgb" />
                <data android:scheme="file" android:pathPattern=".*\\.SGB" />
                <data android:scheme="file" android:pathPattern=".*\\.gbc" />
                <data android:scheme="file" android:pathPattern=".*\\.GBC" />
                <data android:scheme="file" android:pathPattern=".*\\.cgb" />
                <data android:scheme="file" android:pathPattern=".*\\.CGB" />
                <data android:scheme="file" android:pathPattern=".*\\.nes" />
                <data android:scheme="file" android:pathPattern=".*\\.NES" />
                <data android:scheme="file" android:pathPattern=".*\\.unf" />
                <data android:scheme="file" android:pathPattern=".*\\.UNF" />
                <data android:scheme="file" android:pathPattern=".*\\.unif" />
                <data android:scheme="file" android:pathPattern=".*\\.UNIF" />
                <data android:scheme="file" android:pathPattern=".*\\.fds" />
                <data android:scheme="file" android:pathPattern=".*\\.FDS" />
                <data android:scheme="file" android:pathPattern=".*\\.sfc" />
                <data android:scheme="file" android:pathPattern=".*\\.SFC" />
                <data android:scheme="file" android:pathPattern=".*\\.smc" />
                <data android:scheme="file" android:pathPattern=".*\\.SMC" />
                <data android:scheme="file" android:pathPattern=".*\\.swc" />
                <data android:scheme="file" android:pathPattern=".*\\.SWC" />
                <data android:scheme="file" android:pathPattern=".*\\.fig" />
                <data android:scheme="file" android:pathPattern=".*\\.FIG" />
                <data android:scheme="file" android:pathPattern=".*\\.gcm" />
                <data android:scheme="file" android:pathPattern=".*\\.GCM" />
                <data android:scheme="file" android:pathPattern=".*\\.iso" />
                <data android:scheme="file" android:pathPattern=".*\\.ISO" />
                <data android:scheme="file" android:pathPattern=".*\\.rvz" />
                <data android:scheme="file" android:pathPattern=".*\\.RVZ" />
                <data android:scheme="file" android:pathPattern=".*\\.wia" />
                <data android:scheme="file" android:pathPattern=".*\\.WIA" />
                <data android:scheme="file" android:pathPattern=".*\\.gcz" />
                <data android:scheme="file" android:pathPattern=".*\\.GCZ" />
                <data android:scheme="file" android:pathPattern=".*\\.ciso" />
                <data android:scheme="file" android:pathPattern=".*\\.CISO" />
                <data android:scheme="file" android:pathPattern=".*\\.tgc" />
                <data android:scheme="file" android:pathPattern=".*\\.TGC" />
                <data android:scheme="file" android:pathPattern=".*\\.wbfs" />
                <data android:scheme="file" android:pathPattern=".*\\.WBFS" />
                <data android:scheme="file" android:pathPattern=".*\\.wad" />
                <data android:scheme="file" android:pathPattern=".*\\.WAD" />
                <data android:scheme="file" android:pathPattern=".*\\.dol" />
                <data android:scheme="file" android:pathPattern=".*\\.DOL" />
                <data android:scheme="file" android:pathPattern=".*\\.part0\\.iso" />
                <data android:scheme="file" android:pathPattern=".*\\.PART0\\.ISO" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TvActivity"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.EmuCoreD.Splash"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".MainActivityDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityPro"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pro"
            android:roundIcon="@mipmap/ic_launcher_pro_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Discord Social SDK: permissions added by the SDK AAR are not needed. -->
        <activity
            android:name="com.discord.socialsdk.AuthenticationActivity"
            android:process=":discord"
            android:enabled="${discordSdkAvailable}"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="discord-1536775623287115786" />
            </intent-filter>
        </activity>

        <activity
            android:name=".discord.DiscordAuthActivity"
            android:process=":discord"
            android:enabled="${discordSdkAvailable}"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="false" />

        <service
            android:name=".discord.DiscordService"
            android:process=":discord"
            android:enabled="${discordSdkAvailable}"
            android:exported="false" />

        <service
            android:name="com.discord.socialsdk.ForegroundService"
            tools:node="remove" />
    </application>

</manifest>
