# Patch build-local copies only; pinned upstream submodules remain reproducible.
function(emucored_replace_checked variable before after)
    # Git for Windows may check out CRLF while CMake bracket arguments use LF.
    string(REPLACE "\r\n" "\n" normalized "${${variable}}")
    string(FIND "${normalized}" "${before}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Release diagnostics patch no longer matches pinned upstream: ${variable}")
    endif()
    string(REPLACE "${before}" "${after}" changed "${normalized}")
    set(${variable} "${changed}" PARENT_SCOPE)
endfunction()
function(emucored_use_source target original generated)
    get_target_property(sources ${target} SOURCES)
    get_target_property(base ${target} SOURCE_DIR)
    get_filename_component(expected "${original}" ABSOLUTE)
    set(updated)
    set(matches 0)
    foreach(source IN LISTS sources)
        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${base}")
        if(absolute STREQUAL expected)
            list(APPEND updated "${generated}")
            math(EXPR matches "${matches}+1")
        else()
            list(APPEND updated "${source}")
        endif()
    endforeach()
    if(NOT matches EQUAL 1)
        message(FATAL_ERROR "Expected one ${original} in ${target}, found ${matches}")
    endif()
    set_property(TARGET ${target} PROPERTY SOURCES "${updated}")
endfunction()
