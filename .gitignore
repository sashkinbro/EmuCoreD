# Local configuration
local.properties
/docs/

# Local debugging logs and scratch files - never commit
/logs/

# IDE
/.idea/
*.iml
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Local catalog tooling and IGDB credentials - never push these.
/IGDB/
/tools/
/covers/

# Firebase Hosting site sources are deployed from the local working tree only.
/public/

# Firmware / BIOS dumps - never commit
/bios/
*.bin

